#!/bin/bash
# OpenTV Pi : écran de démarrage minimal sur tty1, lancé très tôt par opentv-splash.service (stdout = /dev/tty1).
# Séquences ANSI / console Linux seulement : fond sombre, « OpenTV », « Démarrage... », curseur masqué, puis Cage et
# Chromium prennent le relais. Aucune entrée lue, aucun fichier écrit, aucun réseau. Police Terminus agrandie si la
# distribution la fournit (console-setup/kbd, best effort borné à 2 s). Tout échec est toléré : code de sortie 0,
# le démarrage n'attend jamais cet écran (unité oneshot bornée, aucune dépendance stricte).
# Repli seulement : quand Plymouth affiche déjà l'image OpenTV (option « splash », démon plymouthd vivant), rien
# n'est écrit sur tty1 — ce texte réapparaîtrait au passage au kiosque — et une ligne est notée dans le journal.
set -u

# Chemins fixes en root (unité systemd) ; variables OPENTV_* de test lues seulement hors root
CMDLINE_F=/proc/cmdline
PIDFILE=/run/plymouth/pid
PROC=/proc
if [ "${EUID:-0}" -ne 0 ]; then
  CMDLINE_F="${OPENTV_PROC_CMDLINE:-$CMDLINE_F}"
  PIDFILE="${OPENTV_PLYMOUTH_PIDFILE:-$PIDFILE}"
  PROC="${OPENTV_PROC_ROOT:-$PROC}"
fi
plymouth_refused() {   # nosplash, plymouth.enable=0|false|no|off, rd.plymouth=0|false|no|off
  local w v
  set -f
  for w in $1; do
    case "$w" in
      nosplash) set +f; return 0 ;;
      plymouth.enable=*|rd.plymouth=*)
        v="$(printf '%s' "${w#*=}" | tr '[:upper:]' '[:lower:]')"
        case "$v" in 0|n|no|false|off) set +f; return 0 ;; esac ;;
    esac
  done
  set +f
  return 1
}
plymouth_active() {   # image Plymouth en cours : « splash » noyau (Plymouth non refusé) + plymouthd vivant
  local cmd="" pid="" comm=""
  IFS= read -r cmd 2>/dev/null < "$CMDLINE_F" || true
  plymouth_refused "$cmd" && return 1
  case " $cmd " in *" splash "*) ;; *) return 1 ;; esac
  IFS= read -r pid 2>/dev/null < "$PIDFILE" || return 1
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  IFS= read -r comm 2>/dev/null < "$PROC/$pid/comm" || return 1
  [ "$comm" = plymouthd ]
}
if plymouth_active; then
  printf '%s\n' "opentv-splash: plymouth actif, écran texte non écrit (image OpenTV de Plymouth conservée)" >&2
  exit 0
fi

FONT="/usr/share/consolefonts/Lat15-TerminusBold32x16.psf.gz"
TTY="/dev/tty1"
TITLE="OpenTV"
SUB="Démarrage..."   # ASCII pour les points : présent dans toute police console (é : CP437 et Lat15)
SUB_LEN=12

# police agrandie (16x32) : uniquement sur la vraie console, si setfont et la police officielle existent
if [ -t 1 ] && [ -r "$FONT" ] && command -v setfont >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then
  timeout 2 setfont -C "$TTY" "$FONT" >/dev/null 2>&1 || true
fi

rows=24
cols=80
if [ -t 1 ]; then
  size="$(stty size <&1 2>/dev/null)" || size=""
  r="${size%% *}"
  c="${size##* }"
  case "$r" in ''|*[!0-9]*) ;; *) [ "$r" -ge 3 ] && [ "$r" -le 1000 ] && rows="$r" ;; esac
  case "$c" in ''|*[!0-9]*) ;; *) [ "$c" -ge 16 ] && [ "$c" -le 1000 ] && cols="$c" ;; esac
fi
row=$((rows / 2))
col_t=$(((cols - ${#TITLE}) / 2 + 1))
col_s=$(((cols - SUB_LEN) / 2 + 1))

# palette console Linux (ESC ] P n rrggbb) : 0 = fond sombre, 7 = gris du sous-titre, F = blanc du titre (gras)
# ESC[9;0] : pas de mise en veille de la console ; ESC[?25l : curseur masqué ; ESC[2J : écran effacé au fond sombre
printf '\033]P00b0f17\033]P7a3abbd\033]PFffffff\033[9;0]\033[?25l\033[0;37;40m\033[H\033[2J' 2>/dev/null || exit 0
printf '\033[%d;%dH\033[1;37;40m%s' "$row" "$col_t" "$TITLE" 2>/dev/null || exit 0
printf '\033[%d;%dH\033[0;37;40m%s\033[0;37;40m\033[%d;1H' "$((row + 2))" "$col_s" "$SUB" "$rows" 2>/dev/null || exit 0
exit 0
