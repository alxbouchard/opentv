# /etc/opentv/opentv.env — OpenTV Pi (lu par le service, jamais exécuté). AUCUN secret ici :
# ni Wi-Fi, ni jeton, ni mot de passe. Les valeurs ci-dessous sont les défauts.
#OPENTV_TV_PORT=8080
#OPENTV_SETUP_PORT=8081
#OPENTV_HOTSPOT_ENABLED=1
#OPENTV_HOTSPOT_GRACE_S=60
# durée maximale du Wi-Fi temporaire (120 à 3600 s) ; ensuite il reste fermé jusqu'au redémarrage ou setup reset
#OPENTV_HOTSPOT_MAX_S=1200
#OPENTV_SETUP_TOKEN_TTL_S=600
#OPENTV_WIFI_IFNAME=wlan0
#OPENTV_TV_CLIENT_USER=opentv-kiosk
#OPENTV_FORYOU_SOURCE_ID=films
#OPENTV_CATALOGUE_FILE=/var/lib/opentv/catalogue.json
#OPENTV_HDMI_OUTPUT=HDMI-A-1
#OPENTV_HDMI_MODE=1920x1080
# HDMI-CEC (opentv-cec.timer) : 1 = déclarer la boîte « OpenTV » (Playback) ; 0 = rien. Jamais de réveil de la TV
# ni de changement d'entrée automatique (aucune <Image View On>, aucune <Active Source>) : seulement
# `sudo systemctl start opentv-cec-announce.service`, lancé à la main avec l'accord de l'utilisateur.
#OPENTV_CEC_BOOTSTRAP=1
# 1 = touche CEC « Select » (KEY_OK, ignorée par Chromium) -> Entrée dans la table du noyau (volatile)
#OPENTV_CEC_KEYMAP=1
# Télécommande sur téléphone (repli de la télécommande CEC) : LAN seulement, HTTP (prototype), après configuration,
# sur l'adresse LAN actuelle (jamais 0.0.0.0)
#OPENTV_REMOTE_ENABLED=1
#OPENTV_REMOTE_PORT=8082
# 1 = le QR vise <nom d'hôte>.local:8082 (conservé si l'adresse DHCP change) quand ce nom désigne bien la boîte ;
# 0 = toujours l'adresse LAN actuelle
#OPENTV_REMOTE_MDNS=1
