{
  "manifest_version": 3,
  "name": "OpenTV X TV Mode",
  "description": "Fil X lisible à la télécommande dans le kiosque OpenTV (aucune API X, aucune action automatique).",
  "version": "0.7.7",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "nav.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "x.js"
      ],
      "css": [
        "x.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "http://127.0.0.1/tv*"
      ],
      "js": [
        "tvkey.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
