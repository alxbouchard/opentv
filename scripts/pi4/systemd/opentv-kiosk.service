[Unit]
Description=OpenTV Pi - kiosque Cage (Wayland) + Chromium Raspberry Pi OS sur HDMI (tty1)
Documentation=file:///opt/opentv/README.md
Wants=opentv.service
After=systemd-user-sessions.service plymouth-quit-wait.service opentv.service getty@tty1.service
Conflicts=getty@tty1.service
ConditionPathExists=/dev/tty1
# jamais « failed » après une série de plantages : redémarrage illimité, espacé par RestartSec
StartLimitIntervalSec=0

[Service]
Type=simple
User=opentv-kiosk
# input : donné à Cage par cette unité seulement (comportement du kiosque inchangé) ; le compte opentv-kiosk n'est
# PAS membre du groupe input, si bien que opentv-player.service (même compte) ne l'hérite jamais
SupplementaryGroups=input
PAMName=opentv-kiosk
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
# pas d'effacement de tty1 au lancement : l'écran OpenTV (opentv-splash) reste affiché jusqu'à ce que Cage passe la
# console en mode graphique, et réapparaît (au lieu d'un terminal) si le kiosque redémarre
TTYVTDisallocate=no
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
EnvironmentFile=-/etc/opentv/opentv.env
Environment=XDG_SESSION_TYPE=wayland
# Cage sans « -s » : le changement de console (Ctrl+Alt+Fn) est désactivé, un clavier branché ne mène à aucune
# invite de connexion ; la maintenance passe par SSH.
ExecStart=/usr/bin/cage -d -- /opt/opentv/bin/opentv-kiosk-browser
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
