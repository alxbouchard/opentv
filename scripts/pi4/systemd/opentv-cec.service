[Unit]
Description=OpenTV Pi - amorcage HDMI-CEC borne (Playback OpenTV + touche OK ; une seule annonce par demarrage, jamais de reveil)
Documentation=file:///opt/opentv/README.md
After=systemd-udevd.service opentv-kiosk.service
ConditionPathExistsGlob=/dev/cec*

[Service]
Type=oneshot
User=opentv
Group=opentv
# video : /dev/cecN (root:video) ; input : table de touches du recepteur vc4-hdmi (EVIOCSKEYCODE_V2, aucune lecture)
SupplementaryGroups=video input
ExecStart=/usr/bin/python3 -I /opt/opentv/bin/opentv-pi cec-bootstrap
TimeoutStartSec=60
# temoin de l'annonce de ce demarrage (boot_id ; ecrit apres succes seulement) : tmpfs, efface au redemarrage,
# conserve entre passages de la minuterie et redemarrages du service (aucune reannonce)
RuntimeDirectory=opentv-cec
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
# dossier du jeton TMDb (root:opentv 0750, cree par tmpfiles avant toute unite) : lu seulement par les unites des
# notes. Le DOSSIER est masque (un remplacement atomique du fichier ne peut pas le demasquer).
InaccessiblePaths=-/etc/opentv/tmdb
# ambiance OpenTV Canvas (scene + historique) : reservee a opentv.service (dossier toujours present : tmpfiles)
InaccessiblePaths=-/var/lib/opentv/canvas
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
DevicePolicy=closed
DeviceAllow=char-cec rw
DeviceAllow=char-input rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
