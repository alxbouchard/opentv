[Unit]
Description=OpenTV Pi - connexion de Muse depuis la TV (helper root dedie : pair|cancel|unpair a champs fixes)
Documentation=file:///opt/opentv/README.md
# Lance par opentv-muse-setup.path seulement (pas de section [Install]). Aucun chemin, aucune commande, aucun argument
# ne vient du job : le helper appelle l'administration Muse existante (muse authorize-control/pair/unpair) avec des
# options fixes, jamais --replace-identity ni --force. Le jeton SDK n'existe que dans ce processus (flux memoire).
ConditionPathExists=!/run/opentv-uninstalling
After=opentv.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/opentv/opentv.env
ExecStart=/usr/bin/python3 -I /opt/opentv/bin/opentv-pi muse-setup-helper
# fenetre Bluetooth 600 s + arret/demarrage bornes du pont (museadmin) ; service : echeance globale 1200 s
TimeoutStartSec=1100
UMask=0077
NoNewPrivileges=yes
# fchown des fichiers ecrits pour opentv / opentv-muse (registre, client, etat du pont), jamais plus
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
ProtectSystem=strict
# file des jobs (tmpfs, tmpfiles) : réclamer un job = retirer son nom ; absente ⇒ montée en lecture seule, rien réclamé
ReadWritePaths=/var/lib/opentv -/run/opentv-musejobs /var/lib/opentv-muse /var/lib/opentv-muse-setup /etc/opentv/agents
InaccessiblePaths=-/etc/opentv/tmdb -/etc/opentv/source.env -/etc/NetworkManager/system-connections
InaccessiblePaths=-/var/lib/opentv-kiosk -/run/opentv-player -/run/opentv-player-keys -/run/opentv-cec
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
