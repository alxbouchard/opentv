[Unit]
Description=OpenTV Pi - reactivation HDMI-CEC explicite (source active ; opentv-pi cec --activate)
Documentation=file:///opt/opentv/README.md
After=systemd-udevd.service opentv-kiosk.service
ConditionPathExistsGlob=/dev/cec*

[Service]
Type=oneshot
User=opentv
Group=opentv
# Unité manuelle seulement : jamais activée par l'installateur ni par une minuterie.
SupplementaryGroups=video input
ExecStart=/usr/bin/python3 -I /opt/opentv/bin/opentv-pi cec-bootstrap --force-announce
TimeoutStartSec=60
RuntimeDirectory=opentv-cec
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
# dossier du jeton TMDb (root:opentv 0750, cree par tmpfiles avant toute unite) : lu seulement par les unites des
# notes. Le DOSSIER est masque (un remplacement atomique du fichier ne peut pas le demasquer).
InaccessiblePaths=-/etc/opentv/tmdb
# ambiance OpenTV Canvas (scene + historique) : reservee a opentv.service (dossier toujours present : tmpfiles)
InaccessiblePaths=-/var/lib/opentv/canvas
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
DevicePolicy=closed
DeviceAllow=char-cec rw
DeviceAllow=char-input rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
