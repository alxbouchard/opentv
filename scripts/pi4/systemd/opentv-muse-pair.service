[Unit]
Description=OpenTV Pi - fenetre d'appariement Muse (Bluetooth LE, bornee ; lancee seulement par sudo opentv-pi muse pair)
Documentation=file:///opt/opentv/README.md
# porte humaine : jeton SDK depose hors Git par root (saisie masquee) ; jamais si deja apparie ; aucune commande n'est
# exposee pendant l'appariement (identifiants seulement). Pas de section [Install] : jamais active ni lancee seule.
ConditionPathExists=/var/lib/opentv-muse/sdk_token
ConditionPathExists=!/var/lib/opentv-muse/pairing.json
Conflicts=musegadget.service
Wants=bluetooth.service network-online.target
After=bluetooth.service network-online.target

[Service]
Type=oneshot
User=opentv-muse
Group=opentv-muse
# BlueZ (D-Bus) seulement pendant cette fenetre : le pont lui-meme n'a ni ce groupe ni le bus systeme
SupplementaryGroups=bluetooth
EnvironmentFile=-/etc/opentv/opentv.env
Environment=MUSEGADGET_STATE_DIR=/var/lib/opentv-muse
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -I /opt/opentv/bin/opentv-muse-bridge pair --timeout 600
TimeoutStartSec=700
StateDirectory=opentv-muse
StateDirectoryMode=0700
UMask=0077
MemoryMax=192M
TasksMax=32
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/var/lib/opentv-muse
InaccessiblePaths=-/var/lib/opentv -/var/lib/opentv-kiosk -/var/lib/opentv-install -/etc/opentv/agents
InaccessiblePaths=-/etc/opentv/tmdb -/etc/opentv/source.env -/etc/opentv/playback-promoted
InaccessiblePaths=-/etc/NetworkManager/system-connections -/run/opentv -/run/opentv-player -/run/opentv-player-keys
InaccessiblePaths=-/run/opentv-cec
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# pas de MemoryDenyWriteExecute ici : PyGObject/dbus-python (BlueZ) peuvent exiger des fermetures libffi ; fenetre
# courte et bornee seulement. Le pont permanent (opentv-muse.service), sans D-Bus, le garde.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=localhost link-local multicast
IPAddressAllow=127.0.0.53/32 127.0.0.54/32
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
