[Unit]
Description=OpenTV Pi - garde root du Wi-Fi temporaire (arrete opentv-setup-ap si opentv.service est inactif ou le budget depasse)
Documentation=file:///opt/opentv/README.md
Wants=NetworkManager.service
After=NetworkManager.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /opt/opentv/bin/opentv-pi ap-guard
TimeoutStartSec=60
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
ProtectSystem=strict
# dossier du jeton TMDb : jamais visible ici (lu seulement par les unites des notes)
InaccessiblePaths=-/etc/opentv/tmdb
# ambiance OpenTV Canvas (scene + historique) : reservee a opentv.service (dossier toujours present : tmpfiles)
InaccessiblePaths=-/var/lib/opentv/canvas
ReadWritePaths=/etc/NetworkManager/system-connections
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native
