#!/usr/bin/python3 -I
"""Mode HDMI exact du kiosque (compte opentv-kiosk) : apply (ouvreur, dans Cage) | monitor (opentv-display-mode.service)
| status (lecture seule, JSON). Voir opentv_pi/displaymode.py."""
import os
import sys

_BASE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
for _cand in (os.path.join(_BASE, "lib"), _BASE):
    if os.path.isdir(os.path.join(_cand, "opentv_pi")):
        sys.path.insert(0, _cand)
        break
else:
    sys.stderr.write('{"error": "opentv_pi_missing"}\n')
    sys.exit(2)

from opentv_pi import displaymode  # noqa: E402

sys.exit(displaymode.main(sys.argv[1:]))
