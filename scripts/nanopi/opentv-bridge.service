[Unit]
Description=OpenTV <-> NanoPi bridge (external apps on HDMI 1, native/NANOPI-API.md v1)
Documentation=https://github.com/alxbouchard/opentv
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I %h/opentv-bridge/opentv_bridge.py serve
EnvironmentFile=-%h/.config/systemd/user/opentv-bridge.env
Environment=PYTHONUNBUFFERED=1
Environment=STATE_DIR=%S/opentv-bridge
Environment=LIBSEAT_BACKEND=seatd
StateDirectory=opentv-bridge
Restart=on-failure
RestartSec=3
# navigateur + compositeur sont des enfants : tués avec le service (panne, arrêt, redémarrage)
KillMode=control-group
TimeoutStopSec=12
KillSignal=SIGTERM
NoNewPrivileges=yes
UMask=0077
Nice=5
# en cas de manque de mémoire, Chromium (hérite de ce score) part avant le tableau de bord
OOMScoreAdjust=600

[Install]
WantedBy=default.target
