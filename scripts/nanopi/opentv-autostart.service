[Unit]
Description=OpenTV autostart watcher (launch OpnTV00001.OpenTV on TV power-on via SDB)
Documentation=https://github.com/alxbouchard/opentv
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I %h/opentv-autostart/opentv_autostart.py
EnvironmentFile=-%h/.config/systemd/user/opentv-autostart.env
Environment=PYTHONUNBUFFERED=1
Environment=STATE_FILE=%S/opentv-autostart/state.json
StateDirectory=opentv-autostart
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillSignal=SIGTERM
NoNewPrivileges=yes
Nice=10

[Install]
WantedBy=default.target
